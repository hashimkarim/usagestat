{
  "schemaVersion": 1,
  "id": "claude",
  "name": "Claude",
  "version": "0.0.1",
  "entry": "plugin.js",
  "icon": "icon.svg",
  "brandColor": "#DE7356",
  "links": [
    { "label": "Status", "url": "https://status.anthropic.com/" },
    { "label": "Console", "url": "https://console.anthropic.com/" }
  ],
  "supportedModes": ["oauth", "cli", "web", "local", "api"],
  "autoMode": "oauth",
  "webUrl": "https://claude.ai",
  "usageDashboardUrl": "https://claude.ai/settings/usage",
  "lines": [
    { "type": "progress", "label": "Session", "scope": "overview", "primaryOrder": 1 },
    { "type": "progress", "label": "Weekly", "scope": "overview", "primaryOrder": 2 },
    { "type": "progress", "label": "Sonnet", "scope": "detail" },
    { "type": "progress", "label": "Opus", "scope": "detail" },
    { "type": "progress", "label": "Routines", "scope": "detail" },
    { "type": "text", "label": "Extra usage spent", "scope": "overview", "primaryOrder": 3 },
    { "type": "text", "label": "API Spend", "scope": "overview", "primaryOrder": 4 },
    { "type": "text", "label": "Today", "scope": "detail" },
    { "type": "text", "label": "Yesterday", "scope": "detail" },
    { "type": "text", "label": "Last 30 Days", "scope": "detail" },
    { "type": "barChart", "label": "Usage Trend", "scope": "detail" }
  ]
}
