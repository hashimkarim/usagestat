{
  "schemaVersion": 1,
  "id": "opencode-go",
  "name": "OpenCode Go",
  "version": "0.0.1",
  "entry": "plugin.js",
  "icon": "icon.svg",
  "brandColor": "#000000",
  "links": [
    {
      "label": "Console",
      "url": "https://opencode.ai/auth"
    },
    {
      "label": "Docs",
      "url": "https://opencode.ai/docs/go/"
    }
  ],
  "usageDashboardUrl": "https://opencode.ai/auth",
  "envVars": ["OPENCODE_GO_API_KEY", "OPENCODE_GO_COOKIE", "OPENCODE_GO_WORKSPACE_ID"],
  "supportedModes": ["api", "local", "web"],
  "autoMode": "api",
  "lines": [
    { "type": "text", "label": "Local Cost", "scope": "detail" },
    { "type": "barChart", "label": "Cost History", "scope": "detail" },
    {
      "type": "progress",
      "label": "Session",
      "scope": "overview",
      "primaryOrder": 1
    },
    {
      "type": "progress",
      "label": "Weekly",
      "scope": "overview"
    },
    {
      "type": "progress",
      "label": "Monthly",
      "scope": "detail"
    },
    {
      "type": "text",
      "label": "Renews",
      "scope": "detail"
    },
    {
      "type": "text",
      "label": "Zen balance",
      "scope": "detail"
    }
  ]
}
