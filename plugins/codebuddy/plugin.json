{
  "schemaVersion": 1,
  "id": "codebuddy",
  "name": "CodeBuddy",
  "version": "0.1.0",
  "entry": "plugin.js",
  "enabledByDefault": false,
  "supportedModes": [
    "web",
    "local"
  ],
  "autoMode": "web",
  "webUrl": "https://www.codebuddy.cn",
