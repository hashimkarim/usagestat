  "links": [
    {
      "label": "Dashboard",
      "url": "https://www.codebuddy.cn/profile/plans-usage"
    }
  ],
  "envVars": [
    "CODEBUDDY_HOME",
    "CB_COOKIE_FILE",
    "CB_CREDITS_FILE",
    "CODEBUDDY_COOKIE",
    "CB_COOKIE",
    "CB_API_URL",
    "CB_PACKAGE_CODES"
  ]
}
