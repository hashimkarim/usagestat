{
  "schemaVersion": 1,
  "id": "vercel",
  "name": "Vercel AI Gateway",
  "version": "0.1.0",
  "entry": "plugin.js",
  "enabledByDefault": false,
  "supportedModes": [
    "api"
  ],
  "autoMode": "api",
  "usageDashboardUrl": "https://vercel.com/d?to=%2F%5Bteam%5D%2F%7E%2Fai-gateway",
  "envVars": [
    "AI_GATEWAY_API_KEY",
    "VERCEL_ACCESS_TOKEN",
    "VERCEL_TEAM_ID"
  ],
  "setupFields": [
    {
      "key": "personalBudget",
      "title": "Read personal budget",
      "type": "boolean",
      "description": "Use a Vercel access token and Team ID instead of AI Gateway key credits."
    },
    {
      "key": "VERCEL_ACCESS_TOKEN",
      "title": "Vercel access token",
      "type": "string",
      "description": "Separate account token; the AI Gateway API key is not used for budgets."
    },
    {
      "key": "VERCEL_TEAM_ID",
      "title": "Team ID",
      "type": "string",
      "description": "Team ID or slug whose personal budget belongs to the token user."
    }
  ],
