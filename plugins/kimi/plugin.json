    { "type": "progress", "label": "Weekly", "scope": "overview", "primaryOrder": 2 },
    { "type": "progress", "label": "Monthly", "scope": "overview" },
    { "type": "progress", "label": "Code 7-day", "scope": "detail" }
  ]
