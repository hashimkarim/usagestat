{
  "schemaVersion": 1,
  "id": "workbuddy",
  "name": "WorkBuddy",
  "version": "0.1.0",
  "entry": "plugin.js",
  "enabledByDefault": false,
  "supportedModes": [
    "web"
  ],
  "autoMode": "web",
  "usageDashboardUrl": "https://www.workbuddy.cn",
  "webUrl": "https://workbuddy.cn",
  "envVars": [
    "WORKBUDDY_COOKIE"
  ],
  "setupHelp": "Use a Cookie header from www.workbuddy.cn and the full User-Agent from the same browser. Set Browser User-Agent below. Desktop login files are not imported.",
  "setupFields": [
    {
      "key": "webTimeoutSeconds",
      "title": "Web timeout",
      "type": "string",
      "description": "Provider-specific account or source selection."
    },
    {
      "key": "resetDeadlineMillis",
      "title": "Reset lookup deadline",
      "type": "string",
      "description": "Provider-specific account or source selection."
    },
    {
      "key": "chromeMajorVersion",
      "title": "Chrome major version",
      "type": "string",
      "description": "Provider-specific account or source selection."
    },
    {
      "key": "browserUserAgent",
      "title": "Browser User-Agent",
      "type": "string",
      "description": "Paste the full User-Agent from the same browser session that supplied the cookies. Required for WorkBuddy web readback."
    }
  ],
  "upstream": {
    "repository": "https://github.com/steipete/CodexBar",
    "revision": "6070b29a1a5d51193a634dc1b0a14a67c39d0ccc",
    "path": "Sources/CodexBarCore/Resources/Plugins/workbuddy.js",
    "sha256": "9da73ec195a174e3ee96e3096a47db0b69295bc52dcfceb9fd9d1a2b8f74b08a",
    "license": "MIT"
  }
}
