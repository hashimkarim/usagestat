{
  "schemaVersion": 1,
  "id": "devin",
  "name": "Devin",
  "version": "0.0.1",
  "entry": "plugin.js",
  "icon": "icon.svg",
  "brandColor": "#000000",
  "supportedModes": ["local", "web"],
  "autoMode": "local",
  "envVars": ["DEVIN_BEARER_TOKEN", "DEVIN_AUTHORIZATION", "DEVIN_ORGANIZATION", "DEVIN_ORG"],
  "lines": [
    { "type": "progress", "label": "Weekly quota", "scope": "overview", "primaryOrder": 1 },
    { "type": "progress", "label": "Daily quota", "scope": "overview" },
    { "type": "text", "label": "Extra usage balance", "scope": "detail" }
  ]
}
